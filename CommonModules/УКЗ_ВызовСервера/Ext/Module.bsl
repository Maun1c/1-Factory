Процедура СформироватьТаблицуЗначений() Экспорт

    СписокТоваров = Новый ТаблицаЗначений;
    СписокТоваров.Колонки.Добавить("Товар");
    СписокТоваров.Колонки.Добавить("Остаток");

    СтрокаТовара = СписокТоваров.Добавить();
    СтрокаТовара.Товар = "Яблоки";
    СтрокаТовара.Остаток = 10;

    СтрокаТовара = СписокТоваров.Добавить();
    СтрокаТовара.Товар = "Яблоки";
    СтрокаТовара.Остаток = 20;

    СтрокаТовара = СписокТоваров.Добавить();
    СтрокаТовара.Товар = "Груши";
    СтрокаТовара.Остаток = 5;

    СписокТоваров.Свернуть("Товар", "Остаток");

    Сообщить("Товар - Остаток");
    Для Каждого СтрокаТовара Из СписокТоваров Цикл
        Сообщить(СтрШаблон("%1 - %2",
            СтрокаТовара.Товар, Строка(СтрокаТовара.Остаток)));
    КонецЦикла;

