&НаКлиенте
Процедура АдресКартинкиВХранилищеНажатие(Элемент, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    ЗагрузитьКартинкуАсинх();
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьКартинкуАсинх()
    ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
    ПараметрыДиалога.Заголовок = "Выберите картинку";
    ПараметрыДиалога.МножественныйВыбор = Ложь;
    ПараметрыДиалога.Фильтр = "Изображения (*.png;*.jpg;*.jpeg)|*.png;*.jpg;*.jpeg";

    ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(
        , , , ПараметрыДиалога, УникальныйИдентификатор);

    Если ОписаниеФайла = Неопределено Или ОписаниеФайла.ПомещениеФайлаОтменено Тогда
        Возврат;
    КонецЕсли;

    Если ПодготовитьКартинкуНаСервере(
        ОписаниеФайла.Адрес, ОписаниеФайла.СсылкаНаФайл.Расширение) Тогда
        Модифицированность = Истина;
    Иначе
        Сообщить("Не удалось прочитать картинку. Выбери исправный PNG или JPEG.");
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПодготовитьКартинкуНаСервере(Знач АдресФайла, Знач РасширениеФайла)

    ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
    Попытка
        Изображение = Новый Картинка(ДанныеФайла);
        КартинкаЧитается = Изображение.Ширина() > 0;
    Исключение
        КартинкаЧитается = Ложь;
    КонецПопытки;

    Если Не КартинкаЧитается Тогда
        УдалитьИзВременногоХранилища(АдресФайла);
        Возврат Ложь;
    КонецЕсли;

    Если Не ПустаяСтрока(АдресКартинкиВХранилище) Тогда
        УдалитьИзВременногоХранилища(АдресКартинкиВХранилище);
    КонецЕсли;

    АдресКартинкиВХранилище = АдресФайла;
    РасширениеНовойКартинки = РасширениеФайла;
    КартинкаИзменена = Истина;

    Возврат Истина;

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Объект.Ссылка.Пустая() Тогда
        Возврат;
    КонецЕсли;

    ЗаписьФайла = РегистрыСведений.Файлы.СоздатьМенеджерЗаписи();
    ЗаписьФайла.Объект = Объект.Ссылка;
    ЗаписьФайла.Прочитать();

    Если ЗаписьФайла.Выбран()
        И ТипЗнч(ЗаписьФайла.ДанныеФайла) = Тип("ХранилищеЗначения") Тогда
        ДанныеФайла = ЗаписьФайла.ДанныеФайла.Получить();
        Если ТипЗнч(ДанныеФайла) = Тип("ДвоичныеДанные") Тогда
            АдресКартинкиВХранилище = ПоместитьВоВременноеХранилище(
                ДанныеФайла, УникальныйИдентификатор);
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

    Если Отказ Или Не КартинкаИзменена Тогда
        Возврат;
    КонецЕсли;

    ДанныеФайла = ПолучитьИзВременногоХранилища(АдресКартинкиВХранилище);
    Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
        Сообщить("Выбери картинку заново и повтори запись.");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    ЗаписьФайла = РегистрыСведений.Файлы.СоздатьМенеджерЗаписи();
    ЗаписьФайла.Объект = ТекущийОбъект.Ссылка;
    ЗаписьФайла.ДанныеФайла = Новый ХранилищеЗначения(ДанныеФайла);
    ЗаписьФайла.Расширение = РасширениеНовойКартинки;
    ЗаписьФайла.Размер = ДанныеФайла.Размер();
    ЗаписьФайла.Записать(Истина);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

    КартинкаИзменена = Ложь;

КонецПроцедуры