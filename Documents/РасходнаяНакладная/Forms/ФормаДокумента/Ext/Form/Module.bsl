&НаКлиенте
Процедура ПересчитатьСуммуТовара()
    СтрокаТовара = Элементы.Товары.ТекущиеДанные;
    СуммаБезСкидки = СтрокаТовара.Цена * СтрокаТовара.Количество;
    СтрокаТовара.Сумма = Окр(СуммаБезСкидки * (1 - СтрокаТовара.ПроцентСкидки / 100), 2);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПроцентСкидкиПриИзменении(Элемент)
    ПересчитатьСуммуТовара();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Знач Номенклатура, Знач ДатаДокумента)

    Если Не ЗначениеЗаполнено(Номенклатура)
        Или Не ЗначениеЗаполнено(ДатаДокумента) Тогда
        Возврат 0;
    КонецЕсли;

    Отбор = Новый Структура("Номенклатура", Номенклатура);
    ДанныеЦены = РегистрыСведений.ЦеныНоменклатуры.ПолучитьПоследнее(
        ДатаДокумента, Отбор);

    Возврат ДанныеЦены.Цена;

КонецФункции

&НаКлиенте
Процедура ТоварыТоварПриИзменении(Элемент)

    СтрокаТовара = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТовара = Неопределено Тогда
        Возврат;
    КонецЕсли;

    СтрокаТовара.Цена = ПолучитьЦенуНоменклатуры(СтрокаТовара.Товар, Объект.Дата);
    ПересчитатьСуммуТовара();

КонецПроцедуры

&НаКлиенте
Процедура УслугиУслугаПриИзменении(Элемент)

    СтрокаУслуги = Элементы.Услуги.ТекущиеДанные;
    Если СтрокаУслуги = Неопределено Тогда
        Возврат;
    КонецЕсли;

    СтрокаУслуги.Сумма = ПолучитьЦенуНоменклатуры(СтрокаУслуги.Услуга, Объект.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаИлиКоличествоПриИзменении(Элемент)

    Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
        ПересчитатьСуммуТовара();
    КонецЕсли;

КонецПроцедуры