
&НаКлиенте
Асинх Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

    СписокВидов = Новый СписокЗначений;
    СписокВидов.Добавить(
        ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.Товар"),
        "Товар");
    СписокВидов.Добавить(
        ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.Услуга"),
        "Услуга");
    СписокВидов.Добавить(
        ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.Материал"),
        "Материал");
    СписокВидов.Добавить(
        ПредопределенноеЗначение("Перечисление.ВидыНоменклатуры.РасходныеМатериалы"),
        "Расходный материал");

    ВыбранныйВид = Ждать СписокВидов.ВыбратьЭлементАсинх("Выберите вид номенклатуры");
    Если ВыбранныйВид = Неопределено Тогда
        Возврат;
    КонецЕсли;

    УстановитьВидНаСервере(ПараметрКоманды, ВыбранныйВид.Значение);

    Для Каждого Ссылка Из ПараметрКоманды Цикл
        ОповеститьОбИзменении(Ссылка);
    КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидНаСервере(Знач СсылкиНоменклатуры, Знач НовыйВид)

    НачатьТранзакцию();
    Попытка
        Для Каждого Ссылка Из СсылкиНоменклатуры Цикл
            Если Ссылка.Пустая() Или Ссылка.ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;

            Позиция = Ссылка.ПолучитьОбъект();
            Позиция.ВидНоменклатуры = НовыйВид;
            Позиция.Записать();
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры
