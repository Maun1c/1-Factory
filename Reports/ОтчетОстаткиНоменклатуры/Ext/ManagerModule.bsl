Процедура ПроверитьОтрицательныеОстатки(
    Позиции, ГраницаПроверки, НазваниеПозиции, Отказ) Экспорт

    ПроверенныеПозиции = Новый Соответствие;

    Для Каждого Номенклатура Из Позиции Цикл
        Если ПроверенныеПозиции.Получить(Номенклатура) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ПроверенныеПозиции.Вставить(Номенклатура, Истина);

        Отбор = Новый Структура("Номенклатура", Номенклатура);
        Остатки = РегистрыНакопления.ОстаткиНоменклатуры.Остатки(
            ГраницаПроверки, Отбор);

        Для Каждого СтрокаОстатка Из Остатки Цикл
            Если СтрокаОстатка.Количество < 0 Тогда
                Сообщение = Новый СообщениеПользователю;
                Сообщение.Текст = СтрШаблон(
                    "Не хватает %1 ""%2"" в количестве %3 шт.",
                    НазваниеПозиции, Номенклатура, -СтрокаОстатка.Количество);
                Сообщение.Сообщить();
                Отказ = Истина;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

КонецПроцедуры