Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Набор = Движения.Зарплата;
    Набор.Записывать = Истина;
    МесяцНачисления = НачалоМесяца(Дата);

    Для Каждого СтрокаСотрудника Из СписокСотрудников Цикл
        Запись = Набор.Добавить();
        Запись.ВидРасчета = ПланыВидовРасчета.ВидыРасчета.Оклад;
        Запись.Сотрудник = СтрокаСотрудника.Сотрудник;
        Запись.Ставка = СтрокаСотрудника.Ставка;
        Запись.ПериодРегистрации = МесяцНачисления;
        Запись.ПериодДействияНачало = МесяцНачисления;
        Запись.ПериодДействияКонец = КонецМесяца(МесяцНачисления);
    КонецЦикла;

    Набор.Записать();

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    График.НомерСтроки КАК НомерСтроки,
        |    ЕСТЬNULL(График.КоличествоЧасовФактическийПериодДействия, 0) КАК ФактЧасов
        |ИЗ
        |    РегистрРасчета.Зарплата.ДанныеГрафика(Регистратор = &Документ) КАК График";
    Запрос.УстановитьПараметр("Документ", Ссылка);

    ЧасыПоСтрокам = Новый Соответствие;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ЧасыПоСтрокам.Вставить(Выборка.НомерСтроки, Выборка.ФактЧасов);
    КонецЦикла;

    Для Каждого Запись Из Набор Цикл
        Часы = ЧасыПоСтрокам.Получить(Запись.НомерСтроки);
        Запись.ФактЧасов = ?(Часы = Неопределено, 0, Часы);
        Запись.Сумма = Окр(Запись.ФактЧасов * Запись.Ставка, 2);
    КонецЦикла;

    Набор.Записать(Истина, Истина);

КонецПроцедуры