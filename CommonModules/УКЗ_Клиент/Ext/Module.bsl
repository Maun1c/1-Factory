Процедура СформироватьМассив() Экспорт

    СотрудникиКомпании = Новый Массив;
    СотрудникиКомпании.Добавить("Иванов");
    СотрудникиКомпании.Добавить("Арбузов");
    СотрудникиКомпании.Добавить("Платформов");
    СотрудникиКомпании.Добавить("Физиков");
    СотрудникиКомпании.Добавить("Юриков");
    СотрудникиКомпании.Добавить("Бобров");
    СотрудникиКомпании.Добавить("Федотов");

    СписокФамилий = Новый СписокЗначений;
    СписокФамилий.ЗагрузитьЗначения(СотрудникиКомпании);
    СписокФамилий.СортироватьПоЗначению(НаправлениеСортировки.Возр);
    ОтсортированныеФамилии = СписокФамилий.ВыгрузитьЗначения();

    Индекс = 0;
    Для Каждого Фамилия Из ОтсортированныеФамилии Цикл
        Сообщить(СтрШаблон(
            "Ячейка массива с индексом [%1] имеет значение ""%2""",
            Строка(Индекс), Фамилия));
        Индекс = Индекс + 1;
    КонецЦикла;

КонецПроцедуры

Процедура СформироватьСтруктуру() Экспорт

    Сотрудник = Новый Структура;
    Сотрудник.Вставить("Фамилия", "Иванов");
    Сотрудник.Вставить("Имя", "Виктор");
    Сотрудник.Вставить("Отчество", "Михайлович");
    Сотрудник.Вставить("ДатаРождения", Дата(1993, 5, 15));

    Сегодня = ТекущаяДата();
    ДатаРождения = Сотрудник.ДатаРождения;
    Возраст = Год(Сегодня) - Год(ДатаРождения);

    Если Месяц(Сегодня) < Месяц(ДатаРождения)
        Или (Месяц(Сегодня) = Месяц(ДатаРождения)
            И День(Сегодня) < День(ДатаРождения)) Тогда
        Возраст = Возраст - 1;
    КонецЕсли;

    Инициалы = Лев(Сотрудник.Имя, 1) + "." + Лев(Сотрудник.Отчество, 1) + ".";
   ВозрастТекстом = СтрокаСЧислом(
    ";%1 год;;%1 года;%1 лет;%1 года",
    Возраст,
    ВидЧисловогоЗначения.Количественное);

Сообщить(СтрШаблон("%1 %2 - %3", Сотрудник.Фамилия, Инициалы, ВозрастТекстом));

КонецПроцедуры