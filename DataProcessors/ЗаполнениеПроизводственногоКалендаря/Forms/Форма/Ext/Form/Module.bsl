&НаКлиенте
Процедура ЗаполнитьСписокДней(Команда)

    Если Объект.НормаЧасов <= 0 Тогда
        Сообщить("Пустая норма часов!");
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Объект.ДатаНачала)
        Или Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
        Сообщить("Интервал загрузки не указан!");
        Возврат;
    КонецЕсли;

    ПервыйДень = НачалоДня(Объект.ДатаНачала);
    ПоследнийДень = НачалоДня(Объект.ДатаОкончания);

    Если ПервыйДень > ПоследнийДень Тогда
        Сообщить("Интервал загрузки указан неверно!");
        Возврат;
    КонецЕсли;

    Объект.Дни.Очистить();
    ДеньКалендаря = ПервыйДень;

    Пока ДеньКалендаря <= ПоследнийДень Цикл
        СтрокаДня = Объект.Дни.Добавить();
        СтрокаДня.Дата = ДеньКалендаря;
        СтрокаДня.Рабочий = ДеньНедели(ДеньКалендаря) <= 5;
        СтрокаДня.КоличествоЧасов = Объект.НормаЧасов;

        ДеньКалендаря = ДеньКалендаря + 86400;
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеКалендаря(Команда)

    ЗагрузитьДанныеКалендаряНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеКалендаряНаСервере()

    Если Объект.Дни.Количество() = 0 Тогда
        Сообщить("Нет данных для импорта!");
        Возврат;
    КонецЕсли;

    ДатыИмпорта = Новый Соответствие;

    Для Каждого СтрокаДня Из Объект.Дни Цикл
        Если Не ЗначениеЗаполнено(СтрокаДня.Дата) Тогда
            Сообщить("Заполни дату в каждой строке списка дней.");
            Возврат;
        КонецЕсли;

        ДеньКалендаря = НачалоДня(СтрокаДня.Дата);
        Если ДатыИмпорта.Получить(ДеньКалендаря) <> Неопределено Тогда
            Сообщить("В списке повторяется дата " + Формат(ДеньКалендаря, "ДЛФ=Д"));
            Возврат;
        КонецЕсли;
        ДатыИмпорта.Вставить(ДеньКалендаря, Истина);

        Если СтрокаДня.Рабочий И СтрокаДня.КоличествоЧасов <= 0 Тогда
            Сообщить("Укажи количество часов для рабочего дня "
                + Формат(ДеньКалендаря, "ДЛФ=Д"));
            Возврат;
        КонецЕсли;
    КонецЦикла;

    НачатьТранзакцию();
    Попытка
        Для Каждого СтрокаДня Из Объект.Дни Цикл
            ДеньКалендаря = НачалоДня(СтрокаДня.Дата);
            НаборДня = РегистрыСведений.ПроизводственныйКалендарь.СоздатьНаборЗаписей();
            НаборДня.Отбор.День.Установить(ДеньКалендаря);

            Если СтрокаДня.Рабочий Тогда
                ЗаписьДня = НаборДня.Добавить(); 
                ЗаписьДня.День = ДеньКалендаря;
                ЗаписьДня.КоличествоЧасов = СтрокаДня.КоличествоЧасов;
            КонецЕсли;

            НаборДня.Записать(Истина);
        КонецЦикла;

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

    Сообщить("Данные календаря загружены.");

КонецПроцедуры