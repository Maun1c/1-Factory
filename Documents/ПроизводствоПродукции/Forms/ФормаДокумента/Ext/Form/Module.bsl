&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ВидыМатериалов = Новый Массив;
    ВидыМатериалов.Добавить(Перечисления.ВидыНоменклатуры.Материал);
    ВидыМатериалов.Добавить(Перечисления.ВидыНоменклатуры.РасходныеМатериалы);

    ПараметрыВыбораМатериала = Новый Массив;
    ПараметрыВыбораМатериала.Добавить(Новый ПараметрВыбора(
        "Отбор.ВидНоменклатуры",
        Новый ФиксированныйМассив(ВидыМатериалов)));

    Элементы.СписокМатериаловМатериал.ПараметрыВыбора =
        Новый ФиксированныйМассив(ПараметрыВыбораМатериала);

КонецПроцедуры